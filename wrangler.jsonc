{
  "name": "art-design",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/visits", "/tervezo/api/*", "/payouts", "/payouts/", "/payouts/manifest.json", "/payouts/icon.svg"]
  },
  "rules": [
    { "type": "Text", "globs": ["private/**/*.html"], "fallthrough": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VISITS", "class_name": "VisitCounter" },
      { "name": "LINKS", "class_name": "LinkStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["LinkStore"] }
  ]
}
